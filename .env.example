# Public URLs are embedded into the Next.js client bundle during build.
# Cloud deployment pipelines must override these local development values.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:4000/api"
NEXT_PUBLIC_MEDIA_URL="http://localhost:4000"
# Optional public CDN/media delivery origin. Never put storage credentials here.
NEXT_PUBLIC_MEDIA_DELIVERY_URL=""
