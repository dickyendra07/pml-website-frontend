# Public URLs are embedded into the Next.js client bundle during build.
# Cloud deployment pipelines must override these local development values.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:4000/api"
NEXT_PUBLIC_MEDIA_URL="http://localhost:4000"
# Optional public CDN/media delivery origin. Never put storage credentials here.
NEXT_PUBLIC_MEDIA_DELIVERY_URL=""

# Build-time CSP allowlist for the final origins reached after private-media
# redirects. Use exact HTTPS origins only, separated by commas. Examples:
# AWS: https://private-bucket.s3.ap-southeast-3.amazonaws.com
# Huawei: https://private-bucket.obs.ap-southeast-3.myhuaweicloud.com
CSP_MEDIA_ORIGINS="https://private-bucket.s3.ap-southeast-3.amazonaws.com"

# Server-runtime host allowlist for inbound requests. Production fails closed
# when this is absent. The Docker healthcheck presents the first listed host.
ALLOWED_HOSTS="localhost:3000"
